{
  "name": "wi-admin-backend",
  "version": "1.0.0",
  "description": "Administration backend for the WiMall platform — the only service the admin dashboard talks to",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "lint": "eslint src scripts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "bootstrap:admin": "ts-node scripts/bootstrap-admin.ts",
    "ensure:indexes": "ts-node scripts/ensure-indexes.ts",
    "migrate:status": "ts-node scripts/migrate-status.ts",
    "authz:matrix": "ts-node scripts/print-authz-matrix.ts",
    "audit:export": "ts-node scripts/audit-export.ts",
    "test:foundation": "ts-node scripts/test/test-foundation.ts",
    "test:contract": "ts-node scripts/test/test-api-contract.ts",
    "test:audit": "ts-node scripts/test/test-audit.ts",
    "test:auth": "ts-node scripts/test/test-auth.ts",
    "test:authz": "ts-node scripts/test/test-authz.ts",
    "test:data-access": "ts-node scripts/test/test-data-access.ts",
    "test:users": "ts-node scripts/test/test-users.ts",
    "test:vendors": "ts-node scripts/test/test-vendors.ts",
    "test:orders": "ts-node scripts/test/test-orders.ts",
    "test:shipments": "ts-node scripts/test/test-shipments.ts",
    "test:agents": "ts-node scripts/test/test-agents.ts",
    "test:agencies": "ts-node scripts/test/test-agencies.ts",
    "test:billing": "ts-node scripts/test/test-billing.ts",
    "test:cod": "ts-node scripts/test/test-cod.ts",
    "test:money": "ts-node scripts/test/test-money.ts",
    "test:accounts": "ts-node scripts/test/test-accounts.ts",
    "test:devtools": "ts-node scripts/test/test-devtools.ts",
    "test:notifications": "ts-node scripts/test/test-notifications.ts",
    "test:support": "ts-node scripts/test/test-support.ts",
    "test:content": "ts-node scripts/test/test-content.ts",
    "test:files": "ts-node scripts/test/test-files.ts",
    "test:messaging": "ts-node scripts/test/test-messaging.ts",
    "//verify": [
      "Every verify:* runs through `node --max-old-space-size=4096 -r ts-node/register`,",
      "never a bare `ts-node` (F-4, fixed 2026-08-20).",
      "",
      "These suites boot the whole application in-process and hold a page of real",
      "documents in memory. On the default heap the largest of them dies with",
      "`FATAL ERROR: NewSpace::EnsureCurrentCapacity Allocation failed` after four",
      "minutes — which reads as a hang, not as a memory limit. CI set the flag via",
      "NODE_OPTIONS and nothing set it locally, so the suites CI runs green were the",
      "suites a developer could not finish.",
      "",
      "The flag is in the script rather than in NODE_OPTIONS because an env-var prefix",
      "(`NODE_OPTIONS=... ts-node x`) is not portable: npm runs scripts through cmd.exe",
      "on Windows, where that syntax is a parse error rather than an assignment. This",
      "form needs no cross-env dependency and behaves identically on every platform."
    ],
    "verify:notifications": "node --max-old-space-size=4096 -r ts-node/register scripts/test/verify-notifications-live.ts",
    "verify:live": "node --max-old-space-size=4096 -r ts-node/register scripts/test/verify-live.ts",
    "verify:auth": "node --max-old-space-size=4096 -r ts-node/register scripts/test/verify-auth-live.ts",
    "verify:authz": "node --max-old-space-size=4096 -r ts-node/register scripts/test/verify-authz-live.ts",
    "verify:platform": "node --max-old-space-size=4096 -r ts-node/register scripts/test/verify-platform-live.ts",
    "verify:content": "node --max-old-space-size=4096 -r ts-node/register scripts/test/verify-content-live.ts",
    "verify:files": "node --max-old-space-size=4096 -r ts-node/register scripts/test/verify-files-live.ts",
    "verify:users": "node --max-old-space-size=4096 -r ts-node/register scripts/test/verify-users-live.ts",
    "verify:vendors": "node --max-old-space-size=4096 -r ts-node/register scripts/test/verify-vendors-live.ts",
    "verify:audit": "node --max-old-space-size=4096 -r ts-node/register scripts/test/verify-audit-live.ts",
    "verify:orders": "node --max-old-space-size=4096 -r ts-node/register scripts/test/verify-orders-live.ts",
    "verify:billing": "node --max-old-space-size=4096 -r ts-node/register scripts/test/verify-billing-live.ts",
    "verify:cod": "node --max-old-space-size=4096 -r ts-node/register scripts/test/verify-cod-live.ts",
    "verify:money": "node --max-old-space-size=4096 -r ts-node/register scripts/test/verify-money-live.ts",
    "verify:accounts": "node --max-old-space-size=4096 -r ts-node/register scripts/test/verify-accounts-live.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "pino-pretty": "^13.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "axios": "^1.13.4",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.0.3",
    "otplib": "^12.0.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "rate-limit-redis": "^4.3.1",
    "redis": "^5.10.0",
    "zod": "^3.25.76"
  }
}
