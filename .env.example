# ─── Where a secret COMES FROM (plan step 2.E.1) ──────────────────────────────
# Every secret-bearing block below carries a SOURCE line naming the ORIGIN of the
# value. Three kinds, and the difference decides who can rotate it:
#
#   SOURCE: generated · <command>            we mint it; ours to rotate
#   SOURCE: <provider> console → <where>     they issue it; rotate it there
#   SOURCE: SHARED with <service> as <VAR>   one value, two services, usually TWO
#                                            DIFFERENT NAMES — rotating one side
#                                            alone breaks the seam SILENTLY
#
# At deploy time the value comes from the HOST'S OWN SECRET STORE, never from a
# file in this repository (ADR-019 D-1). This template is the variable → source
# MAPPING; it is not the vault.
#
# Rotation procedure: ../docs/RUNBOOK.md § Rotation.

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8033
LOG_LEVEL=info

# Seconds to let in-flight requests drain on SIGTERM before forcing exit.
SHUTDOWN_TIMEOUT_MS=10000

# Express `trust proxy`. Behind a reverse proxy this MUST be set, or the client IP
# recorded in the audit log (Phase 3) and used for rate limiting is the proxy's.
#   false        direct exposure (default)
#   true         trust every hop  — only behind a proxy you control
#   1            trust one hop
#   10.0.0.0/8   trust a subnet
TRUST_PROXY=false

# ─── Databases ───────────────────────────────────────────────────────────────
# TWO databases, deliberately. `jovi_mall` is the shared platform data this service
# reads and writes alongside the jovi-mall service. `wi-admin` is private to this
# service and holds admin identity, sessions and the audit log — nothing else may
# read it. They are separate URIs (not one connection + useDb) so wi-admin can move
# to its own server later without a code change.
#
# `wi-admin` MUST be a replica-set member (a single-node set is fine) or a mongos.
# An administrator action and its audit row commit in ONE transaction, and Mongo only
# offers transactions on a replica set. The service refuses to start otherwise, rather
# than degrading silently to "audited, probably".
#
# Name the set explicitly. Without `replicaSet=` this works only by driver topology
# discovery, and adding `directConnection=true` while debugging pins the driver to a
# single server — at which point every audited write fails.
#
# SOURCE: Mongo deployment, or the compose stack. Treat BOTH as SECRETS in
#         production — a connection string carries its password inline.
MONGO_URI_PLATFORM=mongodb://localhost:27017/jovi_mall
MONGO_URI_ADMIN=mongodb://localhost:27017/wi-admin?replicaSet=rs0

# ─── Redis ───────────────────────────────────────────────────────────────────
# SOURCE: Redis deployment, or the compose stack. Secret in production.
REDIS_URL=redis://localhost:6379

# ─── Admin authentication ────────────────────────────────────────────────────
# DELIBERATELY NOT jovi-mall's JWT_SECRET. geo-tracker holds that one, so signing
# admin sessions with it would mean a geo-tracker compromise mints admin sessions.
# The accepted cost: geo-tracker cannot verify admin tokens, so admin live tracking
# needs a bridge (designed in the tracking phase).
#
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The two MUST differ — reusing one lets an access token be replayed as a refresh token.
#
# SOURCE: generated · node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#         NOT shared with any other service — see the paragraph above. Rotating
#         either one signs out every administrator, and nothing else: no other
#         service verifies these. That makes them the SAFEST rotation here.
ADMIN_JWT_SECRET=dev_only_access_secret_replace_before_deploying
ADMIN_JWT_REFRESH_SECRET=dev_only_refresh_secret_replace_before_deploying

ADMIN_ACCESS_TOKEN_TTL=900          # 15 min, matching the platform
ADMIN_SESSION_IDLE_TTL=28800        # 8 h  — Redis TTL, refreshed on each request
ADMIN_SESSION_ABSOLUTE_TTL=604800   # 7 d  — hard cap regardless of activity

# 'lax' works when the dashboard and API are same-site (dev, or behind one proxy).
# A genuinely cross-site production deployment needs 'none', which requires Secure
# cookies — so 'none' is REFUSED outside production, where cookies are not Secure and
# the browser would silently drop them. Bearer tokens work either way.
ADMIN_COOKIE_SAMESITE=lax
# ADMIN_COOKIE_DOMAIN=.example.com

ADMIN_LOCKOUT_MAX_ATTEMPTS=5
ADMIN_LOCKOUT_DURATION_S=900

# Tiers at or ABOVE this privilege level must hold TOTP (1 = developers only).
# Such an admin's first sign-in returns a session scoped to the MFA enrolment
# endpoints and nothing else.
ADMIN_MFA_REQUIRED_TIER=1

# ─── Authorization (Phase 3) ─────────────────────────────────────────────────
# How long a four-eyes approval request stays open, in seconds. Default 86400 (24h).
# Long enough that a request made at the end of a day is decidable the next morning,
# short enough that a stale intent cannot be committed against a world that moved on.
# Expired requests are stamped, never deleted.
ADMIN_APPROVAL_TTL_S=86400

# ─── Audit (Phase 3.5) ───────────────────────────────────────────────────────
# The MINIMUM age, in days, before an audit row may leave the database.
#
# A row is deleted only when BOTH hold: it has been exported to a durable file, AND
# it is at least this old. Neither alone is enough — an unexported row is never
# deleted however old it is, and a freshly exported row waits out the remainder.
#
# Changing this does NOT restamp rows already exported under the old value.
# `npm run audit:export -- --restamp` does that, deliberately and visibly.
ADMIN_AUDIT_RETENTION_DAYS=365

# Where export files land. One .ndjson + one .sha256 per export.
ADMIN_AUDIT_EXPORT_DIR=./var/audit-exports

# Ceiling on each of payload/before/after AFTER redaction. Over it, the value is
# replaced by a summary and `stateTruncated` is set — never silently dropped.
ADMIN_AUDIT_MAX_STATE_BYTES=4096

# How long a row may sit at `attempted` before it counts as a dangling intent: an
# action started somewhere this service could not transact with, whose outcome never
# came back. Resolve one by grepping jovi-mall for the same correlation id.
ADMIN_AUDIT_DANGLING_INTENT_S=300

# Row ceiling for POST /audit/exports. Above it the API refuses and names the CLI,
# rather than serialising for minutes inside a request. The CLI has no cap.
ADMIN_AUDIT_EXPORT_API_MAX_ROWS=50000

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated exact origins allowed to call this API with credentials.
# NEVER use a wildcard here: this service is credentialed, and jovi-mall's
# `origin: true` (which reflects any origin) is a defect this replaces.
ADMIN_DASHBOARD_ORIGINS=http://localhost:5175

# ─── jovi-mall (the platform service) ────────────────────────────────────────
# Optional in Phase 1. Unset ⇒ the platform client is INERT and /health/ready
# reports it as `not_configured` rather than failing — the same convention
# jovi-mall itself uses for an unset GEO_TRACKER_BASE_URL.
# Phase 4 makes both REQUIRED, when the shared-logic delegation goes live.
JOVI_MALL_BASE_URL=http://localhost:8022
#
# SOURCE: generated · openssl rand -hex 32
# SOURCE: SHARED with jovi-mall as INTERNAL_ADMIN_SERVICE_TOKEN  ⚠ LOCKSTEP,
#         AND THE TWO NAMES DIFFER. Sent as the `X-Service-Token` header
#         (`infra/platform/platform.client.ts`), not as a bearer. It is a
#         FULL-PRIVILEGE credential over there: jovi-mall re-checks no
#         authorization, so anyone holding this can perform any admin action.
#         ../docs/RUNBOOK.md § Rotation.
JOVI_MALL_SERVICE_TOKEN=must_equal_jovi_mall_INTERNAL_ADMIN_SERVICE_TOKEN_trust_as_is
JOVI_MALL_TIMEOUT_MS=5000
