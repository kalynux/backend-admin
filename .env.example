# ─── Where a secret COMES FROM (plan step 2.E.1) ──────────────────────────────
# Every secret-bearing block below carries a SOURCE line naming the ORIGIN of the
# value. Three kinds, and the difference decides who can rotate it:
#
#   SOURCE: generated · <command>            we mint it; ours to rotate
#   SOURCE: <provider> console → <where>     they issue it; rotate it there
#   SOURCE: SHARED with <service> as <VAR>   one value, two services, usually TWO
#                                            DIFFERENT NAMES — rotating one side
#                                            alone breaks the seam SILENTLY
#
# At deploy time the value comes from the HOST'S OWN SECRET STORE, never from a
# file in this repository (ADR-019 D-1). This template is the variable → source
# MAPPING; it is not the vault.
#
# Rotation procedure: ../docs/RUNBOOK.md § Rotation.

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8033
LOG_LEVEL=info

# Seconds to let in-flight requests drain on SIGTERM before forcing exit.
SHUTDOWN_TIMEOUT_MS=10000

# Express `trust proxy`. Behind a reverse proxy this MUST be set, or the client IP
# recorded in the audit log (Phase 3) and used for rate limiting is the proxy's.
#   false        direct exposure (default)
#   true         trust every hop  — only behind a proxy you control
#   1            trust one hop
#   10.0.0.0/8   trust a subnet
TRUST_PROXY=false

# ─── Databases ───────────────────────────────────────────────────────────────
# TWO databases, deliberately. `jovi_mall` is the shared platform data this service
# reads and writes alongside the jovi-mall service. `wi-admin` is private to this
# service and holds admin identity, sessions and the audit log — nothing else may
# read it. They are separate URIs (not one connection + useDb) so wi-admin can move
# to its own server later without a code change.
#
# `wi-admin` MUST be a replica-set member (a single-node set is fine) or a mongos.
# An administrator action and its audit row commit in ONE transaction, and Mongo only
# offers transactions on a replica set. The service refuses to start otherwise, rather
# than degrading silently to "audited, probably".
#
# Name the set explicitly. Without `replicaSet=` this works only by driver topology
# discovery, and adding `directConnection=true` while debugging pins the driver to a
# single server — at which point every audited write fails.
#
# SOURCE: Mongo deployment, or the compose stack. Treat BOTH as SECRETS in
#         production — a connection string carries its password inline.
MONGO_URI_PLATFORM=mongodb://localhost:27017/jovi_mall
MONGO_URI_ADMIN=mongodb://localhost:27017/wi-admin?replicaSet=rs0

# ─── Redis ───────────────────────────────────────────────────────────────────
# SOURCE: Redis deployment, or the compose stack. Secret in production.
REDIS_URL=redis://localhost:6379

# ─── Admin authentication ────────────────────────────────────────────────────
# DELIBERATELY NOT jovi-mall's JWT_SECRET. geo-tracker holds that one, so signing
# admin sessions with it would mean a geo-tracker compromise mints admin sessions.
# The accepted cost: geo-tracker cannot verify admin tokens, so admin live tracking
# needs a bridge (designed in the tracking phase).
#
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The two MUST differ — reusing one lets an access token be replayed as a refresh token.
#
# SOURCE: generated · node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#         NOT shared with any other service — see the paragraph above. Rotating
#         either one signs out every administrator, and nothing else: no other
#         service verifies these. That makes them the SAFEST rotation here.
ADMIN_JWT_SECRET=dev_only_access_secret_replace_before_deploying
ADMIN_JWT_REFRESH_SECRET=dev_only_refresh_secret_replace_before_deploying

ADMIN_ACCESS_TOKEN_TTL=900          # 15 min, matching the platform
ADMIN_SESSION_IDLE_TTL=28800        # 8 h  — Redis TTL, refreshed on each request
ADMIN_SESSION_ABSOLUTE_TTL=604800   # 7 d  — hard cap regardless of activity

# 'lax' works when the dashboard and API are same-site (dev, or behind one proxy).
# A genuinely cross-site production deployment needs 'none', which requires Secure
# cookies — so 'none' is REFUSED outside production, where cookies are not Secure and
# the browser would silently drop them. Bearer tokens work either way.
ADMIN_COOKIE_SAMESITE=lax
# ADMIN_COOKIE_DOMAIN=.example.com

ADMIN_LOCKOUT_MAX_ATTEMPTS=5
ADMIN_LOCKOUT_DURATION_S=900

# Tiers at or ABOVE this privilege level must hold TOTP (1 = developers only).
# Such an admin's first sign-in returns a session scoped to the MFA enrolment
# endpoints and nothing else.
ADMIN_MFA_REQUIRED_TIER=1

# Per-IP ceiling per minute on the CREDENTIAL endpoints (login, mfa/verify,
# change-password). Bounds one source spraying a password across many accounts —
# which per-account lockout cannot see, because each account sees one attempt.
# ⚠ Raise it behind a shared corporate NAT, where every admin arrives as one IP.
ADMIN_AUTH_RATE_LIMIT_MAX=10

# Per-IP ceiling per minute on /auth/refresh — deliberately its OWN bucket, and
# higher. A refresh is not a credential guess: it presents a rotating token the
# caller already holds. Sharing one bucket with /auth/login meant a handful of tab
# reloads exhausted the allowance, the refresh answered 429, and the client read
# that as a dead session and signed the operator out of a live one. Still bounded,
# because reuse detection is a real signal and an unbounded endpoint is an oracle.
ADMIN_REFRESH_RATE_LIMIT_MAX=60

# Per-minute ceilings for the two GENERAL limiters — Layer A (per IP, before the
# routers) and Layer B (per administrator, at the tail of the auth gate). Every
# number is a backstop, not a budget: if a real administrator ever reaches one, the
# number is wrong. Tier 1 sits highest because it drives the operations surface —
# dependency probes, log searches, the error journal — which is the most
# request-dense work anybody does here; support sits lowest because ticket work is
# human-paced.
#
# ANON is Layer A's ceiling and what an unauthenticated caller gets. It sits ABOVE
# every identity ceiling on purpose, so Layer A only ever catches a flood from one
# address rather than becoming the thing that limits a signed-in administrator —
# that is Layer B's job, and unlike Layer A it can tell administrators apart.
#
# ⚠ Added here 2026-09-09. All four were read at the call site through a local
# envInt() helper, so they appeared in NEITHER this file nor the Zod schema — four
# working levers nobody could find. They are schema-validated now, which also means
# a non-integer stops the boot instead of silently reverting to the default.
ADMIN_RATE_LIMIT_DEVELOPER=2400
ADMIN_RATE_LIMIT_ADMIN=1800
ADMIN_RATE_LIMIT_SUPPORT=1200
ADMIN_RATE_LIMIT_ANON=3000

# ─── Authorization (Phase 3) ─────────────────────────────────────────────────
# How long a four-eyes approval request stays open, in seconds. Default 86400 (24h).
# Long enough that a request made at the end of a day is decidable the next morning,
# short enough that a stale intent cannot be committed against a world that moved on.
# Expired requests are stamped, never deleted.
ADMIN_APPROVAL_TTL_S=86400

# Minimum gap between expiry sweeps, in ms. Per-instance and approximate ON PURPOSE:
# correctness comes from the compare-and-set in `expireOneIfPending`, so two instances
# sweeping at once produce skips, never duplicate rows. Raising it only delays the
# STAMP — `assertDecidable` refuses an overdue request whether the sweep reached it
# or not.
ADMIN_APPROVAL_SWEEP_MIN_INTERVAL_MS=10000

# ─── Feature flags ───────────────────────────────────────────────────────────
# How long a feature-flag read is cached in-process, in ms. `flagEnabled()` sits on
# request paths, so an uncached read costs a Mongo round-trip per gated call.
#
# ⚠ The price is convergence delay, and it makes a flag UNSUITABLE AS AN EMERGENCY
# STOP: `setFlag` clears the cache only on the instance that served the write, and
# every other instance keeps the old value until this elapses. Lower it if you need
# faster convergence; do not set it to 0 expecting a kill switch.
ADMIN_FEATURE_FLAG_CACHE_MS=5000

# ─── Audit (Phase 3.5) ───────────────────────────────────────────────────────
# The MINIMUM age, in days, before an audit row may leave the database.
#
# A row is deleted only when BOTH hold: it has been exported to a durable file, AND
# it is at least this old. Neither alone is enough — an unexported row is never
# deleted however old it is, and a freshly exported row waits out the remainder.
#
# Changing this does NOT restamp rows already exported under the old value.
# `npm run audit:export -- --restamp` does that, deliberately and visibly.
ADMIN_AUDIT_RETENTION_DAYS=365

# Where export files land. One .ndjson + one .sha256 per export.
ADMIN_AUDIT_EXPORT_DIR=./var/audit-exports

# Ceiling on each of payload/before/after AFTER redaction. Over it, the value is
# replaced by a summary and `stateTruncated` is set — never silently dropped.
ADMIN_AUDIT_MAX_STATE_BYTES=4096

# How long a row may sit at `attempted` before it counts as a dangling intent: an
# action started somewhere this service could not transact with, whose outcome never
# came back. Resolve one by grepping jovi-mall for the same correlation id.
ADMIN_AUDIT_DANGLING_INTENT_S=300

# Row ceiling for POST /audit/exports. Above it the API refuses and names the CLI,
# rather than serialising for minutes inside a request. The CLI has no cap.
ADMIN_AUDIT_EXPORT_API_MAX_ROWS=50000

# ─── Notifications (Phase 13) ────────────────────────────────────────────────
# Seconds between projector ticks. An administrator inbox is not a pager: 30s is
# already far tighter than a payout request, a KYC review or a discrepancy moves,
# and the cost of the interval is ten indexed reads across two databases.
#
# `0` DISABLES the timer entirely, and that is a supported way to run this service
# — a second replica that must not double-sweep, or a deploy that wants the API
# without the worker. The read endpoints keep working either way.
ADMIN_NOTIFICATIONS_SWEEP_S=30

# Rows READ per source per tick. Bounds the read; correctness comes from the index.
ADMIN_NOTIFICATIONS_BATCH=200

# Rows DELIVERED per source per tick before the projector truncates and says so.
# ⚠ The case this exists for is `tracking_dispatch_failed`: with geo-tracker
# unreachable, every outbox row parks as `failed` at once, and without a cap one
# outage becomes hundreds of identical notifications in every entitled inbox. Not
# silent — a truncated tick logs at `warn`, and the watermark still advances, so the
# next tick continues rather than repeating.
ADMIN_NOTIFICATIONS_MAX_PER_TICK=25

# Days before an untouched notification is archived, read or not. Unread is not the
# same as still-relevant: what a three-month-old alert was about has been dealt with
# or has not, and the screen that owns it is the honest answer either way.
# `0` disables the sweep.
ADMIN_NOTIFICATIONS_AUTO_ARCHIVE_DAYS=90

# Days an ARCHIVED notification survives before the TTL removes it. Shorter than
# ADMIN_AUDIT_RETENTION_DAYS on purpose, and the gap is the point: a notification is
# a receipt, not a record. What it was about outlives it in `admin_audit_log` and in
# the platform row it was derived from.
ADMIN_NOTIFICATIONS_RETENTION_DAYS=30

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated exact origins allowed to call this API with credentials.
# NEVER use a wildcard here: this service is credentialed, and jovi-mall's
# `origin: true` (which reflects any origin) is a defect this replaces.
ADMIN_DASHBOARD_ORIGINS=http://localhost:5175

# ─── jovi-mall (the platform service) ────────────────────────────────────────
# Optional in Phase 1. Unset ⇒ the platform client is INERT and /health/ready
# reports it as `not_configured` rather than failing — the same convention
# jovi-mall itself uses for an unset GEO_TRACKER_BASE_URL.
# Phase 4 makes both REQUIRED, when the shared-logic delegation goes live.
JOVI_MALL_BASE_URL=http://localhost:8022
#
# SOURCE: generated · openssl rand -hex 32
# SOURCE: SHARED with jovi-mall as INTERNAL_ADMIN_SERVICE_TOKEN  ⚠ LOCKSTEP,
#         AND THE TWO NAMES DIFFER. Sent as the `X-Service-Token` header
#         (`infra/platform/platform.client.ts`), not as a bearer. It is a
#         FULL-PRIVILEGE credential over there: jovi-mall re-checks no
#         authorization, so anyone holding this can perform any admin action.
#         ../docs/RUNBOOK.md § Rotation.
JOVI_MALL_SERVICE_TOKEN=must_equal_jovi_mall_INTERNAL_ADMIN_SERVICE_TOKEN_trust_as_is
JOVI_MALL_TIMEOUT_MS=5000

# ─── File storage, for building public URLs HERE (BR-015 · ADR-021 D-3) ──────
# ⚠ These five names are IDENTICAL to jovi-mall's, deliberately. STORAGE_LOCAL_URL
# is the SIXTH value shared across a service boundary on this platform, and the
# newest lesson already written down is that a new shared value should not also
# be a new NAME to remember — the reason GEO_TRACKER_ADMIN_TOKEN was given a
# matching name. This pair can therefore be diffed directly.
#
# Why this service holds storage configuration at all: `GET /files/library` (the
# media library) builds FileDetail.url itself rather than taking a
# POST /files/resolve hop per page of a browse screen. That REVERSES ADR-009 D-6
# for that one route, knowingly. Every other file route still delegates, and this
# service still holds no bucket, no credential and no signing key.
#
# SOURCE: SHARED with jovi-mall as STORAGE_PROVIDER / STORAGE_LOCAL_URL /
#         STORAGE_FIREBASE_BUCKET / STORAGE_FIREBASE_PUBLIC /
#         STORAGE_R2_PUBLIC_URL — SAME NAMES both
#         sides. ⚠ LOCKSTEP, and a MISMATCH IS SILENT: nothing compares the two
#         values, so a wrong STORAGE_LOCAL_URL fails no boot and logs nothing. It
#         produces URLs that 404 on a screen full of thumbnails, which reads as
#         "the files are gone" rather than as a misconfiguration.
#         ../docs/RUNBOOK.md § Rotation.
#
# Unset ⇒ genuinely INERT, not degraded: every FileDetail.url on the library is
# null, meta.publicUrlsConfigured is false, and one warning is logged. `null` is a
# shape every client already handles (it is the normal answer for a private file),
# whereas a plausible-looking wrong URL is indistinguishable from a working one
# until somebody clicks it. STORAGE_PROVIDER has NO default here on purpose —
# jovi-mall defaults it to `local`, and guessing right by luck is worse than being
# inert.
#
# ⚠ Only `local`, `firebase` and `r2` can be reproduced. `cloudinary` IS implemented
# in jovi-mall and is excluded here anyway: its URL comes from the SDK's own builder,
# which infers a resource type from the key and injects transformation segments.
# Set it and every url is null — correct, and visible via publicUrlsConfigured.
STORAGE_PROVIDER=local
STORAGE_LOCAL_URL=http://localhost:8022/api/files
# STORAGE_FIREBASE_BUCKET=your-project.appspot.com
# STORAGE_FIREBASE_PUBLIC=true
# The Cloudflare CUSTOM DOMAIN bound to the public R2 bucket — the ONLY R2 value
# this service needs, and the only one it holds. No account id, no access key, no
# secret, no bucket name, no private bucket: ADR-021's containment is intact,
# because a CDN hostname is not a credential. Do NOT paste the rest of jovi-mall's
# R2 block here. NO TRAILING SLASH — concatenated as `${base}/${key}` on both sides.
# STORAGE_R2_PUBLIC_URL=https://cdn.yourdomain.com

# The ceiling on POST /api/v1/files/upload, in bytes — the WHOLE multipart request
# body, not a per-file figure, because this service never parses the body and so
# cannot see where one file ends and the next begins (ADR-021 D-2).
#
# ⚠ Deliberately unrelated to jovi-mall's number. Its per-request ceiling is keyed
# on a session ROLE and an administrator's figure there is 2 GB — chosen for a
# surface an administrator can no longer reach. It still resolves (requireAdminCaller
# fabricates role: 'admin'), so a proxy that declared nothing would inherit 2 GB by
# accident. 32 MiB is what an administrator actually uploads: jovi-mall's own policy
# caps an image at 10 MB and a PDF at 25 MB, so this is the largest artefact it
# accepts plus multipart framing. Refusing here means a doomed body never crosses
# the hop.
#
# The accepted MIME list is NOT configurable — see modules/files/domain/upload-limits.ts.
# A knob here would let a deployment advertise a type jovi-mall's pipeline refuses.
ADMIN_UPLOAD_MAX_BYTES=33554432

# ─── geo-tracker (the live-tracking service) ─────────────────────────────────
# TWO doors, two variables, deliberately — and they point at the same host.
#
#   OPS  (Phase 15 · ADR-015 D-5) — /healthz, /readyz, /metrics. No identity, no
#        agent, and a client that can NEVER throw. Surfaced at
#        GET /api/v1/system/geo-tracker[/metrics].
#
#   DATA (Phase 6.I · ADR-020)    — /internal/*, four reads: an agent's presence
#        and live position, a delivery's GPS trail and tracking events.
#
# Keeping them apart is the lever that lets a deployment take the operations
# reads and open NO data door: unset the DATA pair and every tracking read
# answers `configured: false` instead of failing. That is the default.
GEO_TRACKER_OPS_BASE_URL=http://localhost:8090
GEO_TRACKER_OPS_TIMEOUT_MS=2000

# Unset ⇒ no data door. `env.ts` REFUSES a base URL with no token, because that
# combination produces 401s that read as "geo-tracker is broken" rather than
# "this service is misconfigured".
#
# SOURCE: generated · openssl rand -hex 32
# SOURCE: SHARED with geo-tracker as GEO_TRACKER_ADMIN_TOKEN  ⚠ LOCKSTEP — and
#         the FIRST shared secret on this platform whose NAME IS THE SAME on
#         both sides. The other three all differ, which is why rotation needs a
#         runbook; this pair can be diffed directly. A MISMATCH is still silent
#         (nothing compares the two values) but it surfaces here immediately, as
#         tracking reads answering TRACKING_DOOR_REFUSED / SERVICE_TOKEN_INVALID.
#         ../docs/RUNBOOK.md § Rotation.
#
# What that credential may ask for is geo-tracker's GEO_TRACKER_ADMIN_SCOPES, not
# a setting here — the scope model lives on the side that owns the data.
GEO_TRACKER_DATA_BASE_URL=
GEO_TRACKER_ADMIN_TOKEN=
GEO_TRACKER_DATA_TIMEOUT_MS=4000


###############################################################################
#  AUTOMATION FAILURE REPORTS  (ADR-022)
###############################################################################
#
# The n8n automation layer — the customer bot — reporting its own failures to
# POST /api/internal/automation/failures, which administrators then read at
# /api/v1/automation/*.
#
# ⚠ THIS IS THE ONLY INBOUND SERVICE CALLER THIS SERVICE HAS. Every other route
#   answers to an administrator with a tier; this one answers to the shared
#   secret below and sets no identity at all. That is why it lives outside
#   /api/v1 and is pinned by SERVICE_ROUTE_ALLOWLIST — see ADR-022 D-3 for the
#   boundary the next "just one more machine endpoint" request is measured
#   against.
#
# SOURCE: SHARED with the n8n instance as AUTOMATION_REPORT_TOKEN  ⚠ LOCKSTEP
#         — the SAME NAME on both sides, deliberately, so the pair can be
#         diffed directly. n8n's reporter reads it as $env.AUTOMATION_REPORT_TOKEN.
#         It is the SIXTH shared secret on this platform and the FIRST whose
#         other side is not one of the three backends.
#
#         ⚠ A MISMATCH IS SILENT, AND WORSE THAN THE USUAL SILENT MISMATCH.
#         The other shared secrets announce themselves when they drift — a read
#         starts answering "refused". This one fails in the direction of
#         QUIET: reports stop arriving, and an empty failure board looks exactly
#         like a healthy one. That is what `configured` is on both read routes
#         for. ../docs/RUNBOOK.md § Rotation.
#
# Minimum 16 characters, and OPTIONAL. Unset means this deployment has no
# automation layer — a supported posture, not a misconfiguration: the door
# answers 503 AUTOMATION_DOOR_UNCONFIGURED and the reads report
# `configured: false`. Same inert-when-unset shape as the two geo-tracker doors.
AUTOMATION_REPORT_TOKEN=

# How long a failure report survives, in days.
#
# Deliberately short beside ADMIN_AUDIT_RETENTION_DAYS, and it has an
# UNCONDITIONAL TTL where the audit trail's is partial-filtered on an export.
# The reasoning is in ADR-022 D-4 and it is not "the rule was inconvenient":
# these rows are telemetry about a machine, not the record of a person's act,
# and nothing downstream consumes them. If anything ever starts reconciling
# against them, that decision has to be revisited in the same change.
ADMIN_AUTOMATION_RETENTION_DAYS=30
